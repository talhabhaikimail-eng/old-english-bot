# Discord Bot Token
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Discord Server ID (Guild ID) to listen to
# Right-click on server icon -> Copy Server ID
DISCORD_SERVER_ID=your_server_id_here

# Authorized WhatsApp numbers (with country code, no + or spaces).
# The bot will:
#  - Execute commands (.sticker, media links) sent FROM any of these numbers.
#  - Forward Discord messages TO all of these numbers.
# Separate multiple numbers with commas (no spaces around commas).
# Example: 12025551234,923185853847,447911123456
WHATSAPP_RECIPIENT=your_number_here,optional_admin2_here

# ── Dashboard / Cloudflare Tunnel ─────────────────────────────────────────────
# The dashboard React app is built and served statically by the same Node server
# that handles all /api/* routes (dashboard-server.ts, port 4000).
# Both are exposed through a single Cloudflare tunnel — no base URL config needed.
#
# The bot automatically uses a random trycloudflare.com URL each session and
# sends the fresh URL to all WhatsApp admins on startup.
#
# Optional: use a named tunnel for a FIXED domain every session.
# 1. Cloudflare Zero Trust → Tunnels → Create tunnel → copy the token
# 2. Add public hostname: yourdomain.com → localhost:4000
# CLOUDFLARE_TUNNEL_TOKEN=
# DASHBOARD_DOMAIN=dashboard.yourdomain.com

# ── Browser / Cloudflare Tunnel ──────────────────────────────────────────────
# Optional: use a named tunnel for a FIXED browser domain every session.
# 1. Cloudflare Zero Trust → Tunnels → Create tunnel → copy the token
# 2. Add public hostname: browser.yourdomain.com → localhost:10080
# BROWSER_TUNNEL_TOKEN=
# BROWSER_DOMAIN=browser.yourdomain.com
# BROWSER_PORT=10080
# BROWSER_USERNAME=admin
# BROWSER_PASSWORD=your_secure_password

# ── Cloudflare R2 / State Sync ────────────────────────────────────────────────
# Used for persisting VSCode and Chromium state across GitHub Actions restarts
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=your_bucket_name

# ── Domains & Cloudflare Reverse Proxy ────────────────────────────────────────
# General system domain for permanent custom subdomains (e.g. sub-xxxx.ufone-claim.site)
MAIN_DOMAIN=ufone-claim.site

# Portfolio domain for 5-minute isolated demo sandboxes (e.g. demo-xxxx.talhacodes.site)
PORTFOLIO_DOMAIN=talhacodes.site

CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_ZONE_ID=your_cloudflare_zone_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token

# ── Generative AI & Blog Automation ──────────────────────────────────────────
GEMINI_AI_API_KEY=your_gemini_api_key

# ── Portfolio API Security ────────────────────────────────────────────────────
# Optional API Key protecting /api/portfolio/* endpoints
# Pass via header 'X-Portfolio-Key: <key>' or 'Authorization: Bearer <key>' or '?key=<key>'
PORTFOLIO_API_KEY=your_secure_portfolio_api_key_here



